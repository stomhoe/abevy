(
    id: "debug_ui",

    // If false, all debug menu toggles and windows are disabled.
    enable_debug_menus: true,
    // If true, the host-controlled character starts with WallPhaser on spawn.
    wall_phaser: true,
    // If true, connected clients may send certain debug actions to the host.
    client_debug: true,
    drift_file_logging: true,

    // Defaults for the Hot Reload window checkboxes.
    hot_reload_defaults: (
        tiles: false,
        sprite_configs_and_animations: true,
        terrain_oplists_and_noises: true,
        probes_and_filters: true,
        terrgen_settings: true,
        beings_inst_templates: false,
        races: false,
        sexes: false,
    ),

    // Which windows start opened on boot.
    windows_open_on_start: (
        main_menu: true,
        hot_reload_window_open_on_start: false,
        all_states: false,
        terrgen_editor: false,
        terrgen_values: false,
        settings_editor: false,
        daylight: false,
        nav_maps: false,
    ),
)
