sgc {
    id: archi_catas
    structure_id: archi
    weight: 1.0
    tags: [dungeon]
    whitelisted_tags: [dungeon, river]
    max_being_count: 40
    args {
        floor_tile_id: ducatas
        wall_tile_id: nw
        lava_tile_id: lava
        boulder_sampler_id: boulder_sampler
        boulder_frequency: 0.025
        external_doorway_frequency: 0.0
        external_doorway_width_min: 1
        external_doorway_width_max: 2
        external_doorway_wall_axis_preference: any
        disable_terrgen.floor_tile_id: true
        claim_square_min_side_length: 8
        claim_square_max_side_length: 10
        claim_square_normal_mean: 9.0
        claim_square_normal_std_dev: 3.0
        arch_spiral_ring_pack_count_min: 1
        arch_spiral_ring_pack_count_max: 4
        arch_spiral_ring_pack_count_outer_start_pct: 35
        arch_spiral_ring_pack_count_outer_step_pct: 20
        arch_spiral_ring_pack_angle_jitter: 0.35
        room_spawn.center_spiral: [
            dragon, radius_min_pct: 0, radius_max_pct: 8, override_count: 1, pack_spawn_radius: 0, weight: 3.0,
            golem_infernal, radius_min_pct: 14, radius_max_pct: 22, override_count: 1, pack_spawn_radius: 0, weight: 1.5,
            golem_gold, radius_min_pct: 14, radius_max_pct: 22, override_count: 1, pack_spawn_radius: 0, weight: 1.25,
            golem_bronze, radius_min_pct: 14, radius_max_pct: 22, override_count: 1, pack_spawn_radius: 0, weight: 1.0,
            golem, radius_min_pct: 14, radius_max_pct: 22, override_count: 1, pack_spawn_radius: 0, weight: 1.0,
            astaroth, radius_min_pct: 22, radius_max_pct: 32, override_count: 1, pack_spawn_radius: 0, weight: 1.25,
            basilisk, radius_min_pct: 22, radius_max_pct: 32, override_count: 1, pack_spawn_radius: 0, weight: 1.1,
            elemental_fire_ancient, radius_min_pct: 22, radius_max_pct: 32, override_count: 1, pack_spawn_radius: 0, weight: 0.9,
            lich, radius_min_pct: 32, radius_max_pct: 55, override_count: 2, pack_spawn_radius: 0, weight: 1.25,
            demon, radius_min_pct: 32, radius_max_pct: 55, pack_spawn_radius: 0, weight: 1.0,
            medusa, radius_min_pct: 32, radius_max_pct: 55, pack_spawn_radius: 0, weight: 0.9,
            spawn, radius_min_pct: 80, radius_max_pct: 100, pack_spawn_radius: 0, weight: 1.25,
            skeleton, radius_min_pct: 80, radius_max_pct: 100, pack_spawn_radius: 0, weight: 1.0,
        ]
    }
