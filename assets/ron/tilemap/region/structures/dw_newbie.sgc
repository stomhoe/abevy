sgc {
    id = dw_newbie
    structure_id = drunkwalk
    weight = 1.0
    tags = [dungeon]
    whitelisted_tags = [dungeon, river]
    max_being_count = 40
    args {
        floor_tile_id = dunewbie
        wall_tile_id = nw
        lava_tile_id = lava
        boulder_sampler_id = boulder_sampler
        boulder_frequency = 0.015
        external_doorway_frequency = 0.018
        external_doorway_width_min = 1
        external_doorway_width_max = 2
        external_doorway_wall_axis_preference = any
        room_spawn.chamber_circle = [
            { source_id = goblin, override_being_count = 1, pack_spawn_radius = 0, weight = 3.0 },
            { source_id = skeleton, override_being_count = 1, pack_spawn_radius = 0, weight = 2.5 },
            { source_id = medusa, override_being_count = 1, pack_spawn_radius = 0, weight = 1.25 },
            { source_id = ghost, override_being_count = 1, pack_spawn_radius = 0, weight = 1.0 },
            { source_id = spawn, override_being_count = 1, pack_spawn_radius = 0, weight = 0.75 },
            { source_id = golem, override_being_count = 1, pack_spawn_radius = 0, weight = 0.75 },
        ]
        disable_terrgen.floor_tile_id = true
    }
}
