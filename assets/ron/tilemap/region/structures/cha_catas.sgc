sgc {
    id: cha_catas
    structure_id: chamberscorridors
    weight: 1.0
    tags: [dungeon]
    whitelisted_tags: [dungeon, river]
    max_being_count: 40
    args {
        floor_tile_id: ducatas
        floor_b_tile_id: dublack
        wall_tile_id: nw
        lava_tile_id: lava
        rectangle_weight: 1.0
        ellipse_weight: 1.0
        trapezoid_weight: 1.0
        regular_polygon_weight: 1.0
        pentacle_weight: 0.5
        random_chamber_weight: 2.0
        room_size.pentacle.width.min: 12
        room_size.pentacle.height.min: 12
        room_size.random_chamber.width.min: 8
        room_size.random_chamber.height.min: 8
        room_same_shape_weight_rectangle: 1.0
        room_same_shape_weight_ellipse: 1.0
        room_same_shape_weight_trapezoid: 1.0
        room_same_shape_weight_regular_polygon: 1.0
        room_same_shape_weight_pentacle: 0.0
        room_same_shape_chance: 0.25
        room_polygon_min_sides: 4
        room_polygon_max_sides: 12
        room_polygon_rotation_min_deg: 0.0
        room_polygon_rotation_max_deg: 360.0
        corridor_radius: 2
        corridor_wiggle_chance: 0.05
        corridor_wiggle_step_max: 1
        corridor_detour_chance: 0.0
        corridor_detour_max_offset: 0
        corridor_dead_end_chance: 0.10
        external_doorway_frequency: 0.02
        external_doorway_width_min: 1
        external_doorway_width_max: 2
        external_doorway_wall_axis_preference: vertical
        room_spawn.*: [
            skeleton, override_count: 1, weight: 3.0,
            golem_bronze, override_count: 1, weight: 1.0,
            spawn, weight: 1.0,
            golem, override_count: 1, weight: 1.25,
            golem_gold, override_count: 1, weight: 1.0,
            ant, weight: 1.0,
            cyclops, weight: 1.0,
            goblin, weight: 3.0,
            skeleton, weight: 3.0,
            ogre, weight: 2.0,
            medusa, weight: 1.5,
            skeleton, weight: 1.0,
            basilisk, weight: 2,
        ]
        room_spawn.pentacle: [
            demon, weight: 2.0,
            beholder, override_count: 3, weight: 0.5,
            golem_infernal, weight: 0.75,
        ]
        disable_terrgen.floor_tile_id: true
    }
}
