sgc {
    id = spiral_catas
    structure_id = spiral
    weight = 1.0
    tags = [dungeon]
    whitelisted_tags = [dungeon, river]
    max_being_count = 40
    args {
        floor_tile_id = ducatas
        wall_tile_id = nw
        lava_tile_id = lava
        claim_square_min_side_length = 6
        claim_square_max_side_length = 10
        claim_square_normal_mean = 19.0
        claim_square_normal_std_dev = 3.0
        spiral_corridor_width_min = 3
        spiral_corridor_width_max = 5
        spiral_room_radius = 6
        external_doorway_frequency = 0.02
        external_doorway_width_min = 1
        external_doorway_width_max = 2
        external_doorway_wall_axis_preference = vertical
        room_spawn.center_circle = [
            { source_id = dragon, override_being_count = 1, pack_spawn_radius = 0, weight = 2.0 },
            { source_id = dragon_yellow, override_being_count = 1, pack_spawn_radius = 0, weight = 1.5 },
            { source_id = golem_infernal, override_being_count = 1, pack_spawn_radius = 0, weight = 1.0 },
        ]
        room_spawn.arm_inner = [
            { source_id = demon, override_being_count = 1, pack_spawn_radius = 0, weight = 2.0 },
            { source_id = lich, override_being_count = 1, pack_spawn_radius = 0, weight = 1.25 },
            { source_id = golem_gold, override_being_count = 1, pack_spawn_radius = 0, weight = 1.0 },
            { source_id = medusa, override_being_count = 1, pack_spawn_radius = 0, weight = 0.75 },
        ]
        room_spawn.arm_outer = [
            { source_id = skeleton, override_being_count = 1, pack_spawn_radius = 0, weight = 2.5 },
            { source_id = goblin, override_being_count = 1, pack_spawn_radius = 0, weight = 2.0 },
            { source_id = ogre, override_being_count = 1, pack_spawn_radius = 0, weight = 1.25 },
            { source_id = ghost, override_being_count = 1, pack_spawn_radius = 0, weight = 1.0 },
        ]
        disable_terrgen.floor_tile_id = true
    }
}
