(
    id: "normal3",
    /*
        1: continentness (within current island)
        River generation via subtraction of two noises
    */
    operation_operands: [
        //lake calculation
        ("max", ["fnl.lakesmol", "fnl.lakebig"], 3),
        ("*", ["$3", "$1", "0.5"], 3),      //$3: lake strength
        ("*opo", ["$3", "$2"], 3),          //$2: beachness modifier


        //river calculation: difference between two noises
        ("idxmax", ["0.8", "fnl.river.s7"], 4),
        //("abs", ["$4"], 4),                 //$4: river strength (absolute difference)
        ("*", ["$4", "1.0"], 4),            //scale down river strength

        //final decision: which feature is strongest?
        ("idxmax", ["$3", "$4", "$1"], 0),  //compare lake vs river vs tempgrass

    ],
   
    bifs: [
        ("", ["lake"]),                     //index 0: lake branch
        ("", ["orange"]),                    //index 1: river branch
        ("normal4", ["tempgrass"]),         //index 2: tempgrass branch (goes to normal4)
    ],
    root_in_dimensions: [""],
    size: Some((1, 1)),

)

//max(a*(1-b+b_t), b*(1-a+)) > ocean threshold
