id: normal4
tags: [portal]
size: (3, 3)

let sandy_beach_farness = *(COMP gravelness, 1.1)
let shared_pd = pd299

let tree_feature = idxmax(hp81, 0.05)
let tree_feature = max(fnl.forest, tree_feature, water_proximity)
let tree_feature = *(tree_feature, shared_pd, sandy_beach_farness)

let cave_portal_feature = idxmax(hp82, 0.01)
let cave_portal_feature = *(cave_portal_feature, water_proximity, 2.0)

let bush_feature = idxmax(hp82, 0.10)
let bush_feature = *(bush_feature, pd12)
let bush_feature = +(bush_feature, -0.0)

out = idxmax(0.5, tree_feature, cave_portal_feature, bush_feature)

bif "" -> []
bif "" -> [temptree_sampler]
bif "" -> [portal_cave]
bif "" -> [tempveg_sampler]
