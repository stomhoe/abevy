id: normal3
size: (1, 1)
debug: [continentness]



let lakeness = max(fnl.lakesmol, fnl.lakebig)
let lakeness = *(lakeness, inlandness, 0.3)
let lakeness = -(lakeness, beachness)


out = idxmax(continent_threshold, lakeness, )

bif normal4 -> [tempgrass] biomes: [temp=3.5(5.0,0.35)]
bif "" -> [lake]
bif "" -> [orange]
