id: normal3
size: (1, 1)
debug: [continentness, normal_diff]


let lakeness = max(fnl.lakesmol, fnl.lakebig)
let lakeness = *(lakeness, continentness, 0.5)
let lakeness = *opo(lakeness, beachness)

let river_noise = max(fnl.river, fnl.river.s7)
let riverness = *(river_noise, inlandness, continentness, 0.6)
let riverness = riverness * clamp(1.0 - continentness, 0.0, 1.0)
let riverness = clamp(riverness, 0.0, 0.6)

out = idxmax(lakeness, riverness, continentness)

bif "" -> [lake]
bif "" -> [orange]
bif normal4 -> [tempgrass]
