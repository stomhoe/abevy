id: anta3
tags: [portal, land, anta]
size: (1, 1)
debug: [cave_portal_feature]

let lakeness = max(fnl.lakebig)
let lakeness = *(lakeness, continentness, 1.4)
let lakeness = *opo(lakeness, gravelness)

let river_noise = max(fnl.river, fnl.river.s7)
let riverness = *(river_noise, inlandness, continentness, 0.6)
let riverness = riverness * clamp(1.0 - continentness, 0.0, 1.0)
let riverness = clamp(riverness, 0.0, 0.6)

out = idxmax(continentness, lakeness, )

bif anta4 -> [snow]
bif "" -> [ice]
bif "" -> [orange]
