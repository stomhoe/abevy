id: normal2
size: (1, 1)

let water_proximity = lin(continentness, -40.8, 4.54)

let beachness = max(fnl.beachbig, fnl.beachsmol)
let beachness = avg(beachness, 0.3)

let gravelness = *opo(beachness)

let beachness = *(beachness, water_proximity)
let gravelness = *(gravelness, water_proximity)

out = idxmax(0.4, beachness, gravelness)

bif normal3 -> []
bif "" -> [sand]
bif "" -> [gravel]
