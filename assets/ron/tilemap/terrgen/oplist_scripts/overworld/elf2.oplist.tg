id: elf2
size: (1, 1)

let inlandness = continentness/(COMPL continent_threshold)
let shore_proximity = COMPL inlandness * 0.9

let beach_avg_noise = avg(fnl.beachsmol, fnl.beachbig)

let beachness = *(beach_avg_noise, shore_proximity)
let gravelness = *(COMPL beach_avg_noise, shore_proximity)

out = idxmax(0.01, beachness)

bif elf3 -> []
bif "" -> [sand]
bif "" -> [gravel]
