id: normal1
size: (1, 1)
debug: [normal_diff, antiriver, riverness]



let continentness = max(fnl.conti, fnl.penin)
let continentness = *(continentness, normal_diff) - riverness

let continent_threshold = 0.47

out = idxmax(continent_threshold, continentness)



bif "" -> [ocean]
bif normal2 -> []
