id: ow_root
roots: [ow]
size: (1, 1)
debug: [riverness]

let beach_avg_noise = avg(fnl.beachsmol, fnl.beachbig)
let riverness = idxmax(0.9, fnl.river) * 3

let normal_tect = +(fnl.tect, 0.0)
let elf_tect = +(fnl.tect.s2, 0.0)
let anta_tect = +(fnl.tect.s3, -0.2)

let islands_count = 3.
let glob_norm = 0.6/islands_count

let normal_diff = -(normal_tect, elf_tect, anta_tect)/glob_norm
let elf_diff = -(elf_tect, normal_tect, anta_tect)/glob_norm
let anta_diff = -(anta_tect, normal_tect, elf_tect)/glob_norm

out = idxmax(0.5, normal_diff, elf_diff, anta_diff)

bif "" -> [ocean]
bif normal1 -> []
bif elf1 -> []
bif anta1 -> []
