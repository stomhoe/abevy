id: quadruped
abstract: true
extends: core
remove:
  body > neck > head > nose
add:
  body > neck > head > snout | Snout
    nose | Nose
    jaw | Jaw
      mouth | Mouth
  body > leg[0] | Front Left Leg
    foot | Foot
  body > leg[1] | Front Right Leg
    foot | Foot
  body > leg[2] | Hind Left Leg
    foot | Foot
  body > leg[3] | Hind Right Leg
    foot | Foot
  body > tail | Tail
