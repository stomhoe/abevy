id: pawed
extends: quadruped
remove:
  body > leg[0] > foot
  body > leg[1] > foot
  body > leg[2] > foot
  body > leg[3] > foot
add:
  body > leg[0] | Front Left Leg
    foot | Front Left Paw
  body > leg[1] | Front Right Leg
    foot | Front Right Paw
  body > leg[2] | Hind Left Leg
    foot | Hind Left Paw
  body > leg[3] | Hind Right Leg
    foot | Hind Right Paw
