id: humanoid
extends: core
add:
  body > neck > head > jaw | Jaw
    mouth | Mouth
  body > shoulder | Left Shoulder
    arm | Left Arm
      hand | Left Hand
  body > shoulder | Right Shoulder
    arm | Right Arm
      hand | Right Hand
  body > leg | Left Leg
    foot | Left Foot
  body > leg | Right Leg
    foot | Right Foot
