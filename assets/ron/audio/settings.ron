SpatialAudioSettings(
    // 32 px ~= 1 meter
    pixels_per_meter: 32.0,
    // Full volume up to this distance (in meters)
    reference_distance_m: 1.0,
    // Silent at and beyond this distance (in meters)
    max_distance_m: 40.0,
    // 2.0 ~= inverse-square attenuation
    rolloff_exponent: 2.0,
)
