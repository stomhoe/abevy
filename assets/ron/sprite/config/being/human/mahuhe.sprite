// Compatibility aliases for the original human-head IDs.
sprite mahuhe0 extends static_head {
name "Human head 0"
mapped_anims {
    south idle g _ = humahe0_s_idle
    west idle g _ = humahe0_w_idle
    east idle g _ = humahe0_e_idle
    north idle g _ = humahe0_n_idle
}
}
