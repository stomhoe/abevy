anim bat_s_idle {
    img_path: "texture/being/npc/monster/bat.png"
    rows_cols: 4 2
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim bat_s_move {
    img_path: "texture/being/npc/monster/bat.png"
    rows_cols: 4 2
    clips {
        row 0 start_frame 1
    }
}

