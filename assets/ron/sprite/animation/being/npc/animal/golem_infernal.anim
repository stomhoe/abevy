anim golem_infernal_south_idle {
    img_path: "texture/being/npc/monster/golem_infernal.png"
    rows_cols: 4 8
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim golem_infernal_south_move {
    img_path: "texture/being/npc/monster/golem_infernal.png"
    rows_cols: 4 8
    clips {
        row 0 start_frame 1
    }
}

