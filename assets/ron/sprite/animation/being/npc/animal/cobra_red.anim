anim cobra_red_s_idle {
    img_path: "texture/being/npc/reptile/cobra_red.png"
    rows_cols: 4 3
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim cobra_red_s_move {
    img_path: "texture/being/npc/reptile/cobra_red.png"
    rows_cols: 4 3
    clips {
        row 0 start_frame 1
    }
}

