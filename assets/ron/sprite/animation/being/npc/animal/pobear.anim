anim pobear_s_idle {
    img_path: "texture/being/npc/bear/pobear_s.png"
    rows_cols: 1 5
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim pobear_s_move {
    img_path: "texture/being/npc/bear/pobear_s.png"
    rows_cols: 1 5
    clips {
        row 0 start_frame 1
    }
}

