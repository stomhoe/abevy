anim medusa_south_idle {
    img_path: "texture/being/npc/monster/medusa.png"
    rows_cols: 4 9
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim medusa_south_move {
    img_path: "texture/being/npc/monster/medusa.png"
    rows_cols: 4 9
    clips {
        row 0 start_frame 1
    }
}

