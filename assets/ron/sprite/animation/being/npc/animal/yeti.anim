anim yeti_s_idle {
    img_path: "texture/being/npc/monster/yeti.png"
    rows_cols: 4 8
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim yeti_s_move {
    img_path: "texture/being/npc/monster/yeti.png"
    rows_cols: 4 8
    clips {
        row 0 start_frame 1
    }
}

