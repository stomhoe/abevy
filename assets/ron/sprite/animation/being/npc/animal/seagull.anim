anim seagull_south_idle {
    img_path: "texture/being/npc/bird/seagull.png"
    rows_cols: 4 2
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim seagull_south_move {
    img_path: "texture/being/npc/bird/seagull.png"
    rows_cols: 4 2
    clips {
        row 0 start_frame 1
    }
}

