anim bear_s_idle {
    img_path: "texture/being/npc/bear/bear_s.png"
    rows_cols: 2 4
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim bear_s_move {
    img_path: "texture/being/npc/bear/bear_s.png"
    rows_cols: 2 4
    clips {
        row 1 start_frame 1
    }
}

