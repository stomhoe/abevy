anim cyclops_s_idle {
    img_path: "texture/being/npc/monster/cyclops.png"
    rows_cols: 4 6
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim cyclops_s_move {
    img_path: "texture/being/npc/monster/cyclops.png"
    rows_cols: 4 6
    clips {
        row 0 start_frame 1
    }
}

anim cyclops_n_idle {
    img_path: "texture/being/npc/monster/cyclops.png"
    rows_cols: 4 6
    paused: true
    speed: 1.0
    clips {
        row 1 partial 0 0
    }
}

anim cyclops_n_move {
    img_path: "texture/being/npc/monster/cyclops.png"
    rows_cols: 4 6
    clips {
        row 1 start_frame 1
    }
}

anim cyclops_w_idle {
