anim lich_s_idle {
    img_path: "texture/being/npc/monster/lich.png"
    rows_cols: 4 8
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim lich_s_move {
    img_path: "texture/being/npc/monster/lich.png"
    rows_cols: 4 8
    clips {
        row 0 start_frame 1
    }
}

