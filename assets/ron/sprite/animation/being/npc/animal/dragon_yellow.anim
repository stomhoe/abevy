anim dragon_yellow_south_idle {
    img_path: "texture/being/npc/monster/dragon_yellow/dragon_yellow_south.png"
    rows_cols: 4 3
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim dragon_yellow_south_move {
    img_path: "texture/being/npc/monster/dragon_yellow/dragon_yellow_south.png"
    rows_cols: 4 3
    clips {
        row 1 start_frame 1
    }
}

