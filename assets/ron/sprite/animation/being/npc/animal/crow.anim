anim crow_south_idle {
    img_path: "texture/being/npc/bird/crow.png"
    rows_cols: 4 2
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim crow_south_move {
    img_path: "texture/being/npc/bird/crow.png"
    rows_cols: 4 2
    clips {
        row 0 start_frame 1
    }
}

