anim dragon_s_idle {
    img_path: "texture/being/npc/monster/dragon/dragon_s.png"
    rows_cols: 4 3
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim dragon_s_move {
    img_path: "texture/being/npc/monster/dragon/dragon_s.png"
    rows_cols: 4 3
    clips {
        row 0 start_frame 0
        row 1 start_frame 0
        row 2 start_frame 0
    }
}

