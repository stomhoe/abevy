anim evil_tree_s_idle {
    img_path: "texture/being/npc/evil_tree/evil_tree_s.png"
    rows_cols: 2 3
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
        row 1 partial 0 0
    }
}

anim evil_tree_s_move {
    img_path: "texture/being/npc/evil_tree/evil_tree_s.png"
    rows_cols: 2 3
    clips {
        row 0
        row 1
    }
}

