anim bigfoot_artic_south_idle {
    img_path: "texture/being/npc/monster/bigfoot_artic.png"
    rows_cols: 4 6
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim bigfoot_artic_south_move {
    img_path: "texture/being/npc/monster/bigfoot_artic.png"
    rows_cols: 4 6
    clips {
        row 0 start_frame 1
    }
}

