anim elemental_fire_ancient_south_idle {
    img_path: "texture/being/npc/monster/elemental_fire_ancient.png"
    rows_cols: 4 6
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim elemental_fire_ancient_south_move {
    img_path: "texture/being/npc/monster/elemental_fire_ancient.png"
    rows_cols: 4 6
    clips {
        row 0 start_frame 1
    }
}

