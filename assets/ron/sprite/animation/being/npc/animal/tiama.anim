anim tiama_south_idle {
    img_path: "texture/being/npc/tiama.png"
    rows_cols: 4 6
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim tiama_south_move {
    img_path: "texture/being/npc/tiama.png"
    rows_cols: 4 6
    clips {
        row 0 partial 0 4 start_frame 1
    }
}

