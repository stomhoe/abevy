anim unicorn_south_idle {
    img_path: "texture/being/npc/unicorn.png"
    rows_cols: 4 4
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim unicorn_south_move {
    img_path: "texture/being/npc/unicorn.png"
    rows_cols: 4 4
    clips {
        row 0 start_frame 1
    }
}

