anim ghost_bo_s_idle {
    img_path: "texture/being/npc/ghost_bo.png"
    rows_cols: 4 3
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim ghost_bo_s_move {
    img_path: "texture/being/npc/ghost_bo.png"
    rows_cols: 4 3
    clips {
        row 0 start_frame 1
    }
}

