anim turtle_s_idle {
    img_path: "texture/being/npc/reptile/turtle_s.png"
    rows_cols: 2 3
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
        row 1 partial 0 0
    }
}

anim turtle_s_move {
    img_path: "texture/being/npc/reptile/turtle_s.png"
    rows_cols: 2 3
    clips {
        row 0
        row 1
    }
}

