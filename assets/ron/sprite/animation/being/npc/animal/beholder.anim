anim beholder_s_idle {
    img_path: "texture/being/npc/monster/beholder/beholder_s.png"
    rows_cols: 2 3
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
        row 1 partial 0 0
    }
}

anim beholder_s_move {
    img_path: "texture/being/npc/monster/beholder/beholder_s.png"
    rows_cols: 2 3
    clips {
        row 0
        row 1
    }
}

