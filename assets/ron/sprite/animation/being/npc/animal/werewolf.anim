anim werewolf_s_idle {
    img_path: "texture/being/npc/werewolf.png"
    rows_cols: 4 6
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim werewolf_s_move {
    img_path: "texture/being/npc/werewolf.png"
    rows_cols: 4 6
    clips {
        row 0 start_frame 1
    }
}

