anim evil_crow_s_idle {
    img_path: "texture/being/npc/bird/evil_crow.png"
    rows_cols: 4 5
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim evil_crow_s_move {
    img_path: "texture/being/npc/bird/evil_crow.png"
    rows_cols: 4 5
    clips {
        row 0 start_frame 1
    }
}

