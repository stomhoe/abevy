anim bear_cub_south_idle {
    img_path: "texture/being/npc/bear/bear_cub.png"
    rows_cols: 4 5
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim bear_cub_south_move {
    img_path: "texture/being/npc/bear/bear_cub.png"
    rows_cols: 4 5
    clips {
        row 0 start_frame 1
    }
}

