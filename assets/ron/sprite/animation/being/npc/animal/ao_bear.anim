anim ao_bear_east_idle {
    img_path: "texture/being/npc/bear/ao_bear.png"
    rows_cols: 8 4
    paused: true
    speed: 1.0
    clips {
        row 6 partial 1 1
    }
}

anim ao_bear_east_move {
    img_path: "texture/being/npc/bear/ao_bear.png"
    rows_cols: 8 4
    alternating_start_frames: 0 2
    clips {
        row 6
        row 7
    }
}

