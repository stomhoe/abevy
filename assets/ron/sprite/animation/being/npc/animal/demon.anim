anim demon_s_idle {
    img_path: "texture/being/npc/monster/demon.png"
    rows_cols: 4 9
    paused: true
    speed: 1.0
    clips {
        row 0 partial 0 0
    }
}

anim demon_s_move {
    img_path: "texture/being/npc/monster/demon.png"
    rows_cols: 4 9
    clips {
        row 0 start_frame 1
    }
}

